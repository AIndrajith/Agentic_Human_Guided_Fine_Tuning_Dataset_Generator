# Copy to .env and fill in. Both web_api and workers read the repo-root .env.

# ---------- MinIO ----------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=synthetic-data
MINIO_SECURE=false

# ---------- PostgreSQL (docker) ----------
# Used by docker-compose on FIRST init of the postgres volume only.
# Generate each with: python -c "import secrets; print(secrets.token_hex(24))"
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_OWNER_PASSWORD=
APP_DB_PASSWORD=
# runtime (synth_app, data only)
DATABASE_URL=postgresql+psycopg://synth_app:<APP_DB_PASSWORD>@127.0.0.1:5433/synthetic_data
# migrations + LangGraph setup (synth_owner, DDL)
MIGRATION_DATABASE_URL=postgresql+psycopg://synth_owner:<APP_DB_OWNER_PASSWORD>@127.0.0.1:5433/synthetic_data
TEST_DATABASE_URL=postgresql+psycopg://synth_app:<APP_DB_PASSWORD>@127.0.0.1:5433/synthetic_data_test
TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://synth_owner:<APP_DB_OWNER_PASSWORD>@127.0.0.1:5433/synthetic_data_test

# ---------- App secrets ----------
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ---------- Email (Resend) ----------
RESEND_API_KEY=
FROM_EMAIL=
HOST_URL=http://localhost:5173

CORS_ORIGINS=http://localhost:5173

# ---------- Workers / infra ----------
# shared secret workers send as X-Internal-Token: python -c "import secrets; print(secrets.token_hex(24))"
INTERNAL_API_TOKEN=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
QDRANT_URL=http://localhost:6333
WEB_API_URL=http://localhost:8000
OPENAI_API_KEY=
GEMINI_API_KEY=
